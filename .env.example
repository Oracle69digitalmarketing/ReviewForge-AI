# GEMINI_API_KEY: Required for Gemini AI API calls. get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional alternative for Llama 3 (free tier). get one at https://console.groq.com/
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
